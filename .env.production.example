BUDGETSPIN_AUTH_SECRET=replace-with-a-long-random-secret
BUDGETSPIN_HOSTNAME=budget-spin.ts.local
TRAEFIK_DOCKER_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_TLS=true

# --- Itaú email ingest (optional; enable with the `ingest` compose profile) ---
# Use a dedicated mailbox. Gmail app passwords require 2-Step Verification;
# the credential may grant more access than this importer's read-only use.
ITAU_IMAP_HOST=imap.gmail.com
ITAU_IMAP_PORT=993
ITAU_IMAP_USER=your-dedicated-mailbox@example.com
ITAU_IMAP_PASSWORD=replace-with-an-app-password
ITAU_IMAP_MAILBOX=INBOX
# Progress is stored as IMAP UIDVALIDITY and UID in SQLite, not a date window.
# Each pass examines up to 500 UID positions in batches of 50; max 1 MiB per message.
# Optional alternative: Gmail API OAuth. Prepare the credential file first;
# see RUNBOOK. Do not set a real token in this file.
# ITAU_INGEST_PROVIDER=gmail
# GMAIL_CREDENTIALS_PATH=/app/data/gmail-oauth.json
# GMAIL_STATE_PATH=/app/data/gmail-state.json
# Bearer token the cron sidecar uses to call POST /api/ingest/itau.
# Separate secret from BUDGETSPIN_AUTH_SECRET (least privilege). Long and random.
INGEST_TOKEN=replace-with-a-long-random-token
# Seconds between ingest passes (sidecar loop).
INGEST_INTERVAL=900
