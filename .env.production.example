BUDGETSPIN_AUTH_SECRET=replace-with-a-long-random-secret
BUDGETSPIN_HOSTNAME=budget-spin.ts.local
TRAEFIK_DOCKER_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_TLS=true

# --- Itaú email ingest (optional; enable with the `ingest` compose profile) ---
# Use a dedicated mailbox. Gmail app passwords require 2-Step Verification;
# the credential may grant more access than this importer's read-only use.
ITAU_IMAP_HOST=imap.gmail.com
ITAU_IMAP_PORT=993
ITAU_IMAP_USER=your-dedicated-mailbox@example.com
ITAU_IMAP_PASSWORD=replace-with-an-app-password
ITAU_IMAP_MAILBOX=INBOX
# Optional: private (mode 0600) JSON file with {"user","password"}; used when the
# ITAU_IMAP_USER / ITAU_IMAP_PASSWORD variables are not set.
# ITAU_IMAP_CREDENTIALS_PATH=/app/data/imap-credentials.json
# Optional: directory for the IMAP quarantine (UIDs + reason codes only, no bodies).
# ITAU_IMAP_STATE_DIR=/app/data/ingest-state
# Optional: authserv-id of the mailbox provider's own Authentication-Results
# header (the topmost one on a real bank notice, first token before ";").
# Each imported notice records a sender verdict (pass/fail/none) shown in
# /transactions; nothing is blocked. Unset = trust only the topmost header (weaker).
# ITAU_IMAP_AUTHSERV_ID=<mailbox-provider-authserv-id>
# Progress is stored as IMAP UIDVALIDITY and UID in SQLite, not a date window.
# Each pass examines up to 10 windows of 500 UID positions, checkpointing after
# each window; max 1 MiB per message. Unreadable notices are quarantined, not fatal.
# Bearer token the cron sidecar uses to call POST /api/ingest/itau.
# Separate secret from BUDGETSPIN_AUTH_SECRET (least privilege). Must be 32-256
# characters of [A-Za-z0-9_-]; any other value makes the ingest routes answer 503.
# Generate one with: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
INGEST_TOKEN=<generate-with-openssl-rand-base64-48>
# Seconds between ingest passes (sidecar loop).
INGEST_INTERVAL=900
# Seconds between Splitwise sync triggers (`splitwise-ingest` compose profile).
SPLITWISE_INGEST_INTERVAL=3600
